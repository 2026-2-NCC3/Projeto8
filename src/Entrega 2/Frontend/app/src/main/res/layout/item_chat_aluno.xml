<?xml version="1.0" encoding="utf-8"?>
<!-- Fala do aluno: alinhada à direita, com fundo da cor primária. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/txtTextoFala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/fundo_balao_aluno"
        android:padding="12dp"
        android:textColor="@color/white"
        tools:text="O certificado do curso sai quando?" />

    <TextView
        android:id="@+id/txtHoraFala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="27/10/2026 às 19:10" />
</LinearLayout>
